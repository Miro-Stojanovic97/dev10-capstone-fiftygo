### GET all Pins, using authorization
GET {{base_url}}/pin HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{jwt}}

### POST a new Pin, using authorization
POST {{base_url}}/pin HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{jwt}}

{
    "pinDescription": "Test!",
    "pinDate": "2022-10-31",
    "pinPriority": 1,
    "pinDidIt": false,
    "city": {
        "cityId": 1630035577,
        "cityName": "San Juan",
        "stateAbr": "PR",
        "stateName": "Puerto Rico",
        "cityLatitude": "18.3985",
        "cityLongitude": "-66.0610"
    },
    "type": {
        "typeId": 26,
        "typeName": "ski"
    },
    "userId": 4
}

### PUT (update) an existing Pin, using authorization
PUT {{base_url}}/pin/1 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{jwt}}

{
    "pinId": 1,
    "pinDescription": "Testing PUT1!",
    "pinDate": "2022-10-31",
    "pinPriority": 1,
    "pinDidIt": false,
    "city": {
        "cityId": 1630035577,
        "cityName": "San Juan",
        "stateAbr": "PR",
        "stateName": "Puerto Rico",
        "cityLatitude": "18.3985",
        "cityLongitude": "-66.0610"
    },
    "type": {
        "typeId": 26,
        "typeName": "ski"
    },
    "userId": 1
}

### GET Pin by ID, using authorization
GET {{base_url}}/pin/1 HTTP/1.1
Authorization: Bearer {{jwt}}

### DELETE Pin by ID, using authorization
DELETE {{base_url}}/pin/1 HTTP/1.1
Authorization: Bearer {{jwt}}

### GET pin by UserID, using authorization
GET {{base_url}}/pin/user/4 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{jwt}}

### GET all types, using authorization
GET {{base_url}}/type HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{jwt}}

### GET all trips, using authorization
GET {{base_url}}/trip HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{jwt}}

### GET all trips by userId, using authorization
GET {{base_url}}/trip/1 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{jwt}}

### POST a trip, using authorization
POST {{base_url}}/trip HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{jwt}}

